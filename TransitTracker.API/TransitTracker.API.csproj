    <PackageReference Include="Swashbuckle.AspNetCore" Version="6.6.2" />
  </ItemGroup>
  <ItemGroup>
    <ProjectReference Include="..\TransitTracker.Application\TransitTracker.Application.csproj" />
    <ProjectReference Include="..\TransitTracker.Infrastructure\TransitTracker.Infrastructure.csproj" />
  </ItemGroup>
</Project>
