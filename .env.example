REDIS_PORT=6379
REDIS_INSIGHT_PORT=8001
API_PORT=5000
OSRM_PORT=5001

REDIS_CONNECTION=redis:6379
ROUTING_USE_OSRM=true
ROUTING_OSRM_BASE_URL=http://osrm:5000
ROUTING_OSRM_TIMEOUT_SECONDS=8
ROUTING_WARMUP_ON_STARTUP=true

ASPNETCORE_ENVIRONMENT=Development
ASPNETCORE_URLS=http://+:8080
BOOTSTRAP_ENABLED=true
BOOTSTRAP_FORCE_GTFS_IMPORT=false
SIMULATION_ENABLED=true
SIMULATION_TICK_MS=1000
SIMULATION_DWELL_MS=3000
SIMULATION_MAX_CATCH_UP_MINUTES=240
